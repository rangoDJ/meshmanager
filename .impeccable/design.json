      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;gap:8px;border:0;border-radius:8px;padding:8px 14px;font-size:14px;line-height:20px;font-weight:500;background:transparent;color:var(--muted);cursor:pointer;transition:background .15s,color .15s}.ds-btn-ghost:hover{background:var(--surface-2);color:var(--fg)}.ds-btn-ghost:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Label above, hint below, indigo ring on focus.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Name</span><input class=\"ds-input\" placeholder=\"Downloads\"><span class=\"ds-field-hint\">Shown in the library sidebar.</span></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:6px;max-width:320px}.ds-field-label{font-size:14px;font-weight:500;color:var(--fg)}.ds-field-hint{font-size:12px;color:var(--muted)}.ds-input{border:1px solid var(--border);border-radius:8px;padding:8px 12px;font-size:14px;background:var(--surface);color:var(--fg);outline:none;transition:border-color .15s,box-shadow .15s}.ds-input:focus{border-color:var(--accent);box-shadow:0 0 0 2px color-mix(in oklab,var(--accent) 25%,transparent)}"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Flat sheet with hairline border and a title row.",
      "html": "<section class=\"ds-card\"><header class=\"ds-card-head\"><h2>Downloads</h2><button class=\"ds-card-action\">Edit</button></header><p class=\"ds-card-body\">/mnt/downloads · 12,408 files</p></section>",
      "css": ".ds-card{border:1px solid var(--border);border-radius:12px;background:var(--surface);padding:20px;color:var(--fg);max-width:420px}.ds-card-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}.ds-card-head h2{margin:0;font-size:16px;font-weight:600}.ds-card-action{border:0;background:transparent;color:var(--muted);font-size:14px;border-radius:8px;padding:6px 10px;cursor:pointer}.ds-card-action:hover{background:var(--surface-2);color:var(--fg)}.ds-card-action:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.ds-card-body{margin:0;font-size:14px;color:var(--muted);font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Sidebar Navigation",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Muted items; active is indigo text on a 10% indigo wash.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-item\" href=\"#\">Dashboard</a><a class=\"ds-nav-item is-active\" href=\"#\">Library</a><a class=\"ds-nav-item\" href=\"#\">Sources</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:2px;width:224px;padding:8px;background:var(--surface);border-right:1px solid var(--border)}.ds-nav-item{display:flex;align-items:center;gap:12px;border-radius:8px;padding:8px 12px;font-size:14px;color:var(--muted);text-decoration:none;transition:background .15s,color .15s}.ds-nav-item:hover{background:var(--surface-2);color:var(--fg)}.ds-nav-item.is-active{background:color-mix(in oklab,var(--accent) 10%,transparent);color:var(--accent);font-weight:500}.ds-nav-item:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Viewer Corner",
      "kind": "custom",
      "refersTo": "viewer-chrome",
      "description": "Frosted previous / N of M / next group and close button, top-right of every viewer.",
      "html": "<div class=\"ds-corner\"><div class=\"ds-corner-group\"><button aria-label=\"Previous\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"m15 18-6-6 6-6\"/></svg></button><span>3 of 6</span><button aria-label=\"Next\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"m9 18 6-6-6-6\"/></svg></button></div><button class=\"ds-corner-close\" aria-label=\"Close\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M18 6 6 18M6 6l12 12\"/></svg></button></div>",
      "css": ".ds-corner{display:inline-flex;align-items:center;gap:6px;padding:12px;background:var(--surface-2)}.ds-corner-group,.ds-corner-close{display:flex;align-items:center;overflow:hidden;border:1px solid var(--border);border-radius:8px;background:color-mix(in oklab,var(--surface) 90%,transparent);backdrop-filter:blur(8px)}.ds-corner button{border:0;background:transparent;color:var(--muted);padding:8px;display:grid;place-items:center;cursor:pointer;transition:color .15s}.ds-corner button:hover{color:var(--fg)}.ds-corner button:focus-visible{outline:2px solid var(--accent);outline-offset:-2px}.ds-corner span{padding:0 4px;font-size:12px;color:var(--muted);font-variant-numeric:tabular-nums}"
    },
    {
