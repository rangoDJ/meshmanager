      "kind": "chip",
      "refersTo": "tool-button-active",
      "description": "Frosted strip of presets; the active one fills indigo; scrolls sideways on narrow screens.",
      "html": "<div class=\"ds-seg\"><button class=\"is-on\" aria-pressed=\"true\">Iso</button><button>Front</button><button>Back</button><button>Left</button><button>Right</button><button>Top</button><button>Bottom</button></div>",
      "css": ".ds-seg{display:flex;max-width:100%;overflow-x:auto;scrollbar-width:none;font-size:12px;border:1px solid var(--border);border-radius:8px;background:color-mix(in oklab,var(--surface) 90%,transparent);backdrop-filter:blur(8px)}.ds-seg button{flex-shrink:0;border:0;background:transparent;color:var(--muted);padding:6px 10px;cursor:pointer;transition:color .15s}.ds-seg button:hover{color:var(--fg)}.ds-seg button.is-on{background:var(--accent);color:var(--accent-fg)}.ds-seg button:focus-visible{outline:2px solid var(--accent);outline-offset:-2px}"
    },
    {
