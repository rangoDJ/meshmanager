      "html": "<button class=\"ds-btn-secondary\">Rescan</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--border);border-radius:8px;padding:8px 14px;font-size:14px;line-height:20px;font-weight:500;background:var(--surface);color:var(--fg);cursor:pointer;transition:background .15s}.ds-btn-secondary:hover{background:var(--surface-2)}.ds-btn-secondary:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
