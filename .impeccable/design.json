      "description": "Frosted bar fixed at the bottom of the library while files are selected; labels always visible, 40px targets.",
      "html": "<div class=\"ds-bulk\"><p><b>3 files</b> selected</p><div><button class=\"is-on\">Tag</button><button>Collection</button><button>Print queue</button></div></div>",
      "css": ".ds-bulk{display:flex;flex-wrap:wrap;align-items:center;gap:4px 12px;max-width:672px;border:1px solid var(--border);border-radius:12px;background:color-mix(in oklab,var(--surface) 90%,transparent);backdrop-filter:blur(8px);padding:8px 12px;color:var(--fg)}.ds-bulk p{margin:0;font-size:14px;font-variant-numeric:tabular-nums}.ds-bulk div{margin-left:auto;display:flex;gap:6px}.ds-bulk button{height:40px;border:1px solid var(--border);border-radius:8px;background:var(--surface);color:var(--fg);padding:0 12px;font-size:14px;font-weight:500;cursor:pointer}.ds-bulk button:hover{background:var(--surface-2)}.ds-bulk button.is-on{border-color:var(--accent);background:color-mix(in oklab,var(--accent) 10%,transparent);color:var(--accent)}.ds-bulk button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
