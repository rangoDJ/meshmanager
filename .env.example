# Copy to .env and adjust. Every value is optional.
# This file only covers deployment. App settings (scanning, thumbnails, …) are changed
# on the Settings page and saved to data/config.json.

# Host port for the web UI
PORT=8080

# Change before first start; Postgres keeps the password it was initialised with.
POSTGRES_PASSWORD=change-me

# Host user/group that owns ./data (run `id` on the host)
PUID=1000
PGID=1000

TZ=UTC

# true when behind a reverse proxy that sets X-Forwarded-For / X-Forwarded-Proto
TRUST_PROXY=false

# Create the admin account on first start (otherwise the web UI asks)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Use a published image instead of building locally
# MM_IMAGE=ghcr.io/rangodj/meshmanager:latest
